<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Restful Booker API Suite" verbose="1">
    <test name="Auth Tests">
        <classes>
            <class name="com.owais.restassured.tests.AuthTests"/>
        </classes>
    </test>
    <test name="Booking CRUD Tests">
        <classes>
            <class name="com.owais.restassured.tests.BookingCrudTests"/>
        </classes>
    </test>
    <test name="Booking Negative Tests">
        <classes>
            <class name="com.owais.restassured.tests.BookingNegativeTests"/>
        </classes>
    </test>
    <test name="Booking Data-Driven Tests">
        <classes>
            <class name="com.owais.restassured.tests.BookingDataDrivenTests"/>
        </classes>
    </test>
    <test name="Schema and Performance Tests">
        <classes>
            <class name="com.owais.restassured.tests.BookingSchemaAndPerformanceTests"/>
        </classes>
    </test>
</suite>
